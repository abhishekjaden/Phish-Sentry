# PhishGuard Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# Flask
FLASK_SECRET_KEY=CHANGE_ME_run_python_c_import_secrets_print_secrets_token_hex_32

# Gemini API (Google AI Studio → https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Database (SQLite for now, PostgreSQL later)
DATABASE_URL=sqlite:///phishing.db

# Admin (only used on first run to create admin account)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_use_a_strong_password

JWT_SECRET_KEY=